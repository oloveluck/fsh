#lang racket/base

;;; ig-ips-test.rkt — the International Patient Summary IG 2.0.1, compiled from its own FSH sources
;;; (tests/vendor/ips-2.0.1, the HL7/fhir-ips repo at tag 2.0.1) and compared with its published
;;; package (see ig-harness.rkt for what is normalised). Needs the published package from the
;;; `fhir-spec` package; skipped with a note when it is not installed.
;;;
;;; RATCHETED — floors only rise. Known and out of scope:
;;;   - ActorDefinition ×3: an R5 resource the IG Publisher converts to Basic for an R4 IG
;;;   - ImplementationGuide ×1: generated by SUSHI from sushi-config.yaml, which is not read here

(require rackunit racket/runtime-path
         (only-in fhir/r4/schemas)                         ; IPS is FHIR 4.0.1
         (only-in fhir/spec-package spec-package-path)
         (only-in fhir/sd/sd-index current-sd-packages)
         "ig-harness.rkt")

(define-runtime-path ips "vendor/ips-2.0.1")
(define published (spec-package-path "hl7.fhir.uv.ips.tgz" #:optional? #t))
(define r4-core (spec-package-path "hl7.fhir.r4.core.tgz" #:optional? #t))

(cond
  [(not (and published r4-core))
   (printf "  IPS IG corpus: skipped (needs the fhir-spec package: raco pkg install fhir-spec)\n")]
  [else
   (define r (parameterize ([current-sd-packages (list r4-core)])
               (check-fsh-ig ips published "http://hl7.org/fhir/uv/ips")))
   (printf "  IPS 2.0.1 from FSH: ~a resources paired; ~a exact, ~a with all published content; SD differential ~a/~a elements\n"
           (ig-fsh-report-pairs r) (ig-fsh-report-exact r) (ig-fsh-report-contained r)
           (ig-fsh-report-elements-ok r) (ig-fsh-report-elements-total r))
   (for ([e (in-list (ig-fsh-report-errors r))]) (eprintf "     compile error ~a: ~a\n" (car e) (cdr e)))
   (printf "  difference classes (published vs ours), largest first:\n")
   (print-classes r)
   (check-equal? (ig-fsh-report-errors r) '())
   (check-equal? (sort (map cdr (ig-fsh-report-ours-unmatched r)) string<?) '("Consumer" "Creator" "Server")) ; ActorDefinition
   (check-equal? (map car (ig-fsh-report-published-unmatched r)) '("Basic" "Basic" "Basic" "ImplementationGuide"))
   (check-true (>= (ig-fsh-report-pairs r) 114))
   (check-true (>= (ig-fsh-report-exact r) 84) "fewer exact resources than the floor")
   (check-true (>= (ig-fsh-report-contained r) 106) "fewer fully-matching resources than the floor")
   (check-true (>= (ig-fsh-report-elements-ok r) 435) "fewer matching differential elements than the floor")])
