{"abstract":false,"baseDefinition":"http://hl7.org/fhir/StructureDefinition/Observation","derivation":"constraint","description":"Records the dimensions of a tumor","differential":{"element":[{"constraint":[{"expression":"(focus.exists() or specimen.exists()) and (focus.exists() and specimen.exists()).not()","human":"Either `focus` OR `specimen` MUST be populated","key":"must-have-focus-or-specimen-invariant","severity":"error","source":"http://hl7.org/fhir/us/mcode/StructureDefinition/mcode-tumor-size"}],"id":"Observation","path":"Observation"},{"id":"Observation.code","path":"Observation.code","patternCodeableConcept":{"coding":[{"code":"21889-1","system":"http://loinc.org"}]}},{"definition":"The patient whose tumor was measured. SHALL be a `Patient` resource conforming to `CancerPatient`.","id":"Observation.subject","max":"1","min":1,"mustSupport":true,"path":"Observation.subject","short":"The patient whose tumor was measured.","type":[{"code":"Reference","targetProfile":["http://hl7.org/fhir/us/mcode/StructureDefinition/mcode-cancer-patient"]}]},{"comment":"Use **only** when the tumor **has not** been removed from the body. If the tumor has been removed, use `specimen` instead and leave `focus` empty.","definition":"Reference to a BodyStructure resource conforming to Tumor.","id":"Observation.focus","max":"1","min":0,"path":"Observation.focus","short":"Identifies a tumor that has NOT been removed from the body","type":[{"code":"Reference","targetProfile":["http://hl7.org/fhir/us/mcode/StructureDefinition/mcode-tumor"]}]},{"definition":"Not used in this profile","id":"Observation.value[x]","path":"Observation.value[x]","short":"Not used in this profile"},{"binding":{"strength":"extensible","valueSet":"http://hl7.org/fhir/us/mcode/ValueSet/mcode-tumor-size-method-vs"},"comment":"Tumors are typically measured via gross pathology after excision, or via diagnostic imaging or physical exam prior to removal. If `specimen` is set, `method` is expected to be a \"gross pathology\" code. If `focus` is set, `method` is expected to be a type of diagnostic imaging or physical exam.","definition":"Method for measuring the tumor","id":"Observation.method","path":"Observation.method","short":"Method for measuring the tumor"},{"comment":"Use specimen **only** when the tumor **has** been removed from the body. If the tumor has been not removed, use `focus` instead and leave `specimen` empty.","definition":"Reference to a Specimen resource consistent with HumanSpecimen with type = http://terminology.hl7.org/CodeSystem/v2-0487#TUMOR.","id":"Observation.specimen","path":"Observation.specimen","short":"Identifies a tumor that has been removed from the body","type":[{"code":"Reference","targetProfile":["http://hl7.org/fhir/us/mcode/StructureDefinition/mcode-human-specimen"]}]},{"id":"Observation.component","min":1,"path":"Observation.component","slicing":{"description":"Slice based on the component.code value","discriminator":[{"path":"code","type":"value"}],"rules":"open"}},{"definition":"The longest tumor dimension in cm or mm.","id":"Observation.component:tumorLongestDimension","max":"1","min":1,"mustSupport":true,"path":"Observation.component","short":"Longest tumor dimension (cm or mm)","sliceName":"tumorLongestDimension"},{"id":"Observation.component:tumorLongestDimension.code","mustSupport":true,"path":"Observation.component.code","patternCodeableConcept":{"coding":[{"code":"33728-7","system":"http://loinc.org"}]}},{"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/us/mcode/ValueSet/mcode-tumor-size-units-vs"},"id":"Observation.component:tumorLongestDimension.value[x]","mustSupport":true,"path":"Observation.component.value[x]","type":[{"code":"Quantity"}]},{"comment":"Additional tumor dimensions should be ordered from largest to smallest.","definition":"The second or third tumor dimension in cm or mm.","id":"Observation.component:tumorOtherDimension","max":"2","min":0,"mustSupport":true,"path":"Observation.component","short":"2nd or 3rd tumor dimension (cm or mm)","sliceName":"tumorOtherDimension"},{"id":"Observation.component:tumorOtherDimension.code","mustSupport":true,"path":"Observation.component.code","patternCodeableConcept":{"coding":[{"code":"33729-5","system":"http://loinc.org"}]}},{"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/us/mcode/ValueSet/mcode-tumor-size-units-vs"},"id":"Observation.component:tumorOtherDimension.value[x]","mustSupport":true,"path":"Observation.component.value[x]","type":[{"code":"Quantity"}]}]},"extension":[{"url":"FMM","valueInteger":3}],"fhirVersion":"4.0.1","id":"mcode-tumor-size","kind":"resource","mapping":[{"identity":"workflow","name":"Workflow Pattern","uri":"http://hl7.org/fhir/workflow"},{"identity":"sct-concept","name":"SNOMED CT Concept Domain Binding","uri":"http://snomed.info/conceptdomain"},{"identity":"v2","name":"HL7 v2 Mapping","uri":"http://hl7.org/v2"},{"identity":"rim","name":"RIM Mapping","uri":"http://hl7.org/v3"},{"identity":"w5","name":"FiveWs Pattern Mapping","uri":"http://hl7.org/fhir/fivews"},{"identity":"sct-attr","name":"SNOMED CT Attribute Binding","uri":"http://snomed.org/attributebinding"}],"name":"TumorSize","resourceType":"StructureDefinition","status":"active","title":"Tumor Size Profile","type":"Observation","url":"http://hl7.org/fhir/us/mcode/StructureDefinition/mcode-tumor-size","version":"0.1.0"}